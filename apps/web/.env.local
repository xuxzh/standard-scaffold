# 复制为 apps/web/.env.local 后，按需调整以下配置。
# VITE_ENABLE_API_MOCKING=true 时，应用会启用 MSW 拦截浏览器请求，适合长期本地联调。
# VITE_API_BASE_URL 用于未开启 API mock 时访问真实 app API。
# VITE_WMS_API_BASE_URL 用于未开启 API mock 时访问真实 WMS API。
# VITE_MES_API_BASE_URL 用于未开启 API mock 时访问真实 MES API。
# DEV_API_PROXY_ENABLED 控制 Vite dev server 是否注册 /api/* 反向代理（默认 true）。
# 关闭时（DEV_API_PROXY_ENABLED=false）需要把 VITE_*_API_BASE_URL 改成绝对地址。
VITE_ENABLE_API_MOCKING=false
VITE_API_BASE_URL=/api/app
VITE_WMS_API_BASE_URL=/api/wms
VITE_MES_API_BASE_URL=/api/mes
VITE_PRINT_API_BASE_URL=/api/print

DEV_API_PROXY_ENABLED=true
DEV_API_PROXY_TARGET=http://192.168.0.135:8288
DEV_WMS_API_PROXY_TARGET=http://192.168.0.135:8283
DEV_MES_API_PROXY_TARGET=http://192.168.0.135:8282
DEV_PRINT_API_PROXY_TARGET=http://192.168.0.135:3002
