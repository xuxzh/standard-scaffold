generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PackagingType {
  id              Int       @id @default(autoincrement())
  companyCode     String
  factoryCode     String
  typeCode        String
  typeName        String
  isRecyclable    Boolean   @default(false)
  description     String?
  remark          String?
  creatorUserId   Int?
  creatorUserName String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@unique([companyCode, factoryCode, typeCode])
  @@index([companyCode, factoryCode, deletedAt])
}

enum AiConversationStatus {
  active
  archived
}

enum AiMessageStatus {
  pending
  streaming
  completed
  stopped
  failed
}

enum AiRunStatus {
  queued
  running
  completed
  stopped
  failed
  interrupted
}

enum AiQueryEvidenceStatus {
  running
  completed
  failed
}

model AiConversation {
  id              String               @id @default(uuid()) @db.Uuid
  companyCode     String
  factoryCode     String
  userKey         String
  userName        String?
  title           String
  hermesSessionId String               @unique
  contextVersion  String
  status          AiConversationStatus @default(active)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deletedAt       DateTime?
  messages        AiMessage[]
  runs            AiRun[]

  @@index([companyCode, factoryCode, userKey, deletedAt])
  @@index([updatedAt])
}

model AiMessage {
  id              String          @id @default(uuid()) @db.Uuid
  conversationId  String          @db.Uuid
  role            String
  content         String
  sequence        Int
  status          AiMessageStatus
  errorCode       String?
  completedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  conversation    AiConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userRun         AiRun?          @relation("AiRunUserMessage")
  assistantRun    AiRun?          @relation("AiRunAssistantMessage")

  @@unique([conversationId, sequence])
  @@index([conversationId, createdAt])
}

model AiRun {
  id                 String            @id @default(uuid()) @db.Uuid
  conversationId     String            @db.Uuid
  userMessageId      String            @unique @db.Uuid
  assistantMessageId String            @unique @db.Uuid
  hermesRunId        String?
  status             AiRunStatus       @default(queued)
  startedAt          DateTime?
  endedAt            DateTime?
  errorCode          String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  conversation       AiConversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userMessage        AiMessage         @relation("AiRunUserMessage", fields: [userMessageId], references: [id], onDelete: Cascade)
  assistantMessage   AiMessage         @relation("AiRunAssistantMessage", fields: [assistantMessageId], references: [id], onDelete: Cascade)
  evidence           AiQueryEvidence[]

  @@index([conversationId, status])
  @@index([status])
}

model AiQueryEvidence {
  id             String                @id @default(uuid()) @db.Uuid
  runId          String                @db.Uuid
  toolName       String
  sql            String
  companyCode    String
  factoryCode    String
  timeRangeStart DateTime?
  timeRangeEnd   DateTime?
  dataCutoffAt   DateTime?
  status         AiQueryEvidenceStatus @default(running)
  startedAt      DateTime              @default(now())
  endedAt        DateTime?
  durationMs     Int?
  rowCount       Int?
  truncated      Boolean?
  errorCode      String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  run            AiRun                 @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
}
