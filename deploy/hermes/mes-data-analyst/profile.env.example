# API server is loopback-only and uses a dedicated non-default port.
API_SERVER_ENABLED=true
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8650
API_SERVER_KEY=REPLACE_WITH_A_RANDOM_64_HEX_VALUE

# Configure the inference provider/model required by this isolated profile.
# Use `hermes model` with HERMES_HOME set to the profile directory, or add the
# provider-specific secret variables documented by Hermes.

# Dedicated read-only SQL login. Do not use sa or an application write account.
MES_DB_SERVER=REPLACE_WITH_MES_SERVER
MES_DB_PORT=1433
MES_DB_DATABASE=REPLACE_WITH_MES_DATABASE
MES_DB_USER=REPLACE_WITH_READ_ONLY_USER
MES_DB_PASSWORD=REPLACE_WITH_READ_ONLY_PASSWORD
MES_DB_ENCRYPT=true
MES_DB_TRUST_SERVER_CERTIFICATE=false
