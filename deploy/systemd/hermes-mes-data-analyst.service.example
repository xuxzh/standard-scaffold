[Unit]
Description=Hermes MES Data Analyst Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hermes-mes
Group=hermes-mes
WorkingDirectory=/opt/standard-scaffold/current
Environment=HERMES_HOME=/var/lib/hermes-mes/profiles/mes-data-analyst
EnvironmentFile=/etc/standard-scaffold/hermes-mes.env
ExecStart=/usr/local/bin/hermes gateway run
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hermes-mes

[Install]
WantedBy=multi-user.target
