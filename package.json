{
  "name": "frontend-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@repo/web",
    "dev:api": "turbo dev --filter=@repo/api",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "verify": "pnpm lint && pnpm typecheck && pnpm --filter @repo/web test && pnpm --filter @repo/web-e2e test:e2e && pnpm build",
    "verify:web": "pnpm --filter @repo/web lint && pnpm --filter @repo/web typecheck && pnpm --filter @repo/web test && pnpm --filter @repo/web build",
    "verify:e2e": "pnpm --filter @repo/web-e2e test:e2e",
    "test:e2e": "pnpm --filter @repo/web-e2e test:e2e",
    "test:e2e:mock": "pnpm --filter @repo/web-e2e test:e2e:mock",
    "test:e2e:headed": "pnpm --filter @repo/web-e2e test:e2e:headed",
    "test:e2e:staging": "pnpm --filter @repo/web-e2e test:e2e:staging"
  },
  "devDependencies": {
    "turbo": "^2.6.1",
    "typescript": "^5.9.3"
  }
}
